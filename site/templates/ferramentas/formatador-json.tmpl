<section class="ferramenta">
  <nav aria-label="breadcrumb">
    <ul>
      <li><a href="/ferramentas">Ferramentas</a></li>
      <li>{{.Title}}</li>
    </ul>
  </nav>
  <h2>{{.Title}}</h2>
  <p>{{.Description}}</p>
  <form class="json-tool">
    <label for="json">JSON</label>
    <textarea id="json" name="json" rows="14" spellcheck="false" placeholder='{"nome": "George", "linguagens": ["Go", "Ruby"]}' aria-describedby="json-status"></textarea>
    <small id="json-status" aria-live="polite"></small>
    <div class="tool-actions">
      <select name="indent" aria-label="Indentação">
        <option value="2">2 espaços</option>
        <option value="4">4 espaços</option>
        <option value="tab">Tab</option>
      </select>
      <button type="submit" name="action" value="format">Formatar</button>
      <button type="submit" name="action" value="minify" class="secondary">Minificar</button>
      <button type="button" class="secondary outline" data-copy="#json">Copiar</button>
    </div>
  </form>
  <noscript><p>Esta ferramenta precisa de JavaScript.</p></noscript>
</section>
<script src="/js/ferramentas/formatador-json.js"></script>
