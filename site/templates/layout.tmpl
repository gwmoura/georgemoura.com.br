<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content="{{.Description}}">
    <meta name="keywords" content="HTML,CSS,XML,JavaScript,PHP,Ruby,Python,Go,Java,{{.Keywords}}">
    <meta name="author" content="George Moura">
    <title>George Moura | {{.Title}}</title>
    <link rel="icon" href="//www.gravatar.com/avatar/563562a5c924aac52c903ddf4fd80fa8">
    <link rel="canonical" href="https://{{host}}{{.Link}}">
    <script>
      // Aplica o tema antes da renderização para evitar o "flash" de tema errado
      (function () {
        var theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (!theme) theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <link rel="stylesheet" href="/css/pico.min.css">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/highlight.js/9.2.0/styles/monokai-sublime.min.css">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    {{if ne (hasString current "cv") true}}
    <header class="site-header">
      <nav class="container">
        <ul>
          <li><a href="/" class="brand" title="George Moura">George Moura</a></li>
        </ul>
        <ul class="nav-desktop">
          <li><a href="/" title="Início">Início</a></li>
          <li><a href="/blog" title="Blog">Blog</a></li>
          <li><a href="/contatos" title="Contatos">Contatos</a></li>
          <li><a href="/curriculo" target="_blank" title="Currículo">Currículo</a></li>
          <li><a href="/euli" target="_blank" title="EuLi">Eu Li</a></li>
          <li><a href="//feeds.feedburner.com/georgemoura" title="Assinar Posts">RSS</a></li>
          <li>
            <button type="button" class="theme-toggle" title="Alternar tema escuro/claro" aria-label="Alternar tema escuro/claro">
              <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
              <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            </button>
          </li>
        </ul>
        <details class="dropdown nav-mobile">
          <summary aria-label="Menu">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </summary>
          <ul dir="rtl">
            <li><a href="/" title="Início">Início</a></li>
            <li><a href="/blog" title="Blog">Blog</a></li>
            <li><a href="/contatos" title="Contatos">Contatos</a></li>
            <li><a href="/curriculo" target="_blank" title="Currículo">Currículo</a></li>
            <li><a href="/euli" target="_blank" title="EuLi">Eu Li</a></li>
            <li><a href="//feeds.feedburner.com/georgemoura" title="Assinar Posts">RSS</a></li>
            <li><a href="#" class="theme-toggle" role="button" title="Alternar tema escuro/claro">Alternar tema</a></li>
          </ul>
        </details>
      </nav>
    </header>
    {{end}}
    <main class="container">
      <!-- Render the current template here -->
      {{ yield }}
    </main>
    {{if ne (hasString current "cv") true}}
    <aside class="container anuncio">
      <small>anúncio</small>
      <script async src="//pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
      <!-- George Site -->
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-7444396631758040"
           data-ad-slot="9531772347"
           data-ad-format="auto"></ins>
      <script>
      (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
    <footer class="site-footer">
      <div class="container">
        <nav class="social" aria-label="Redes sociais">
